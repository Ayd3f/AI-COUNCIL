# ============================================================================
#  AI COUNCIL — configuration
#  Copy this file to `.env` (same directory) and fill in your keys.
#  `.env` is git-ignored. Keys are read by the backend only and are NEVER
#  sent to the browser.
# ============================================================================

# ---------------------------------------------------------------- API KEYS --
# You need at least TWO providers for a debate to make sense.
# Leave a key empty to exclude that provider from the council.
#
#   OpenAI     https://platform.openai.com/api-keys
#   Anthropic  https://console.anthropic.com/settings/keys
#   Google     https://aistudio.google.com/apikey
#   xAI        https://console.x.ai/
#   DeepSeek   https://platform.deepseek.com/api_keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --------------------------------------------- ПРОВАЙДЕРЫ С БЕСПЛАТНЫМ ТАРИФОМ
# Карта для регистрации не нужна. Лимиты меняются — проверяйте у провайдера.
#
#   Groq Cloud  https://console.groq.com/keys      быстрый, щедрый суточный лимит
#   Cerebras    https://cloud.cerebras.ai/         большой лимит по токенам
#   Mistral     https://console.mistral.ai/api-keys/  собственные модели
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Локальная модель: ключ не нужен, вопрос никуда не уходит, лимитов нет.
# Поставьте Ollama (https://ollama.com/download), выполните `ollama pull llama3.1`
# и раскомментируйте строку ниже. Для LM Studio адрес будет http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=

# ВАЖНО: не ставьте одну и ту же открытую модель двум участникам (например
# Llama-70B и на Groq, и на Cerebras) — в совете окажется один голос дважды,
# спорить будет не с кем, а согласие получится фальшивым.

# ------------------------------------------------------------------ MODELS --
# Fully configurable — nothing in the architecture is tied to a specific model.
# Check each provider's model list and set whatever you want to use.
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-5
GEMINI_MODEL=gemini-3.5-flash
XAI_MODEL=grok-3
DEEPSEEK_MODEL=deepseek-v4-flash
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=llama-3.3-70b
MISTRAL_MODEL=mistral-large-latest
OLLAMA_MODEL=llama3.1

# Anthropic thinking mode for structured replies:
#   disabled  the whole token budget goes to the JSON payload (default, cheapest)
#   adaptive  the model reasons first — better quality, roughly 2x the tokens
#   default   send nothing and use the model's own default
ANTHROPIC_THINKING=disabled

# --------------------------------------------------------------- ENDPOINTS --
# Only change these to point at a proxy or a compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------ DEBATE RULES --
MIN_ROUNDS=1
MAX_ROUNDS=5
CONSENSUS_THRESHOLD=0.8

# Круглый стол с ролями. Каждый участник получает свою роль в споре
# (Адвокат, Критик, Фактчекер, Практик, Примиритель, Аналитик) и активно
# переубеждает остальных, а не просто высказывает мнение параллельно.
# false — прежнее поведение без ролей.
DEBATE_ROLES=true

# Кто играет Адвоката — того, кто тянет совет к одному ответу. Он один на
# совет: двое «тянущих» тянули бы в разные стороны.
# "auto" — первый подключённый участник. Или укажите имя: CLAUDE, OPENAI, ...
ADVOCATE_AGENT=auto

# Which agent writes the final synthesis prose, in a neutral SYNTHESIS ENGINE
# role. "auto" picks the first healthy agent. The quantitative parts of the
# final report are always computed in code, never by a model.
SYNTHESIS_AGENT=auto

# ------------------------------------------------------- REQUEST HANDLING ---
TEMPERATURE=0.7
REQUEST_TIMEOUT=60
MAX_RETRIES=2
MAX_TOKENS=4000
MAX_QUESTION_LENGTH=4000

# ---------------------------------------------------------------- DATABASE --
# SQLite for the MVP. For PostgreSQL:
#   pip install asyncpg
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aicouncil
DATABASE_URL=sqlite+aiosqlite:///./ai_council.db

# ------------------------------------------------------------------ SERVER --
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
PRICING_FILE=pricing.json
LOG_LEVEL=INFO
